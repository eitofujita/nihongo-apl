# Copy the existing public project values from .env.local; no secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PLUS_PRICE_JPY=980
BILLING_ENABLED=false
# Live AI stays disabled for the initial zero-cost verification.
