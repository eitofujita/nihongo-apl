# Guest learning works without external services. Never put a secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLUS_PRICE_JPY=980
# Enable accounts after applying all three supabase/migrations files.
# Use the project Connect dialog's public URL and publishable key.
# Do NOT use a secret key or service_role key. Neither is needed at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Future server-only AI settings (live AI is not enabled yet)
AI_API_KEY=
AI_MODEL=
AI_DAILY_FREE_LIMIT=3
AI_DAILY_PLUS_LIMIT=30
# Billing remains disabled until a supported payment provider is integrated.
BILLING_ENABLED=false
