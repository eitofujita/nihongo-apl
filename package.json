{
  "name": "nihongo-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "NIHONGO_LIVE_TESTS=1 vitest run tests/supabase-live.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:cloudflare": "node --experimental-strip-types scripts/cloudflare.mts build",
    "preview:cloudflare": "node --experimental-strip-types scripts/cloudflare.mts preview",
    "check:cloudflare": "node --experimental-strip-types scripts/cloudflare.mts dry-run",
    "deploy:cloudflare": "node --experimental-strip-types scripts/cloudflare.mts deploy",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "content": "node --experimental-strip-types scripts/build-content.mts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.577.0",
    "next": "^16.1.0",
    "next-intl": "^4.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@next/env": "16.4.6",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "4.164.0"
  }
}
